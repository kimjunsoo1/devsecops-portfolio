---
import { devsecops } from '../lib/data';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const weeks = devsecops.roadmap;
---
<div>
  <div class="progress" aria-hidden="true">{weeks.map(() => <i class="done"></i>)}</div>
  <div class="progress-label"><span>8-week roadmap</span><span>{weeks.length}/{weeks.length} weeks done</span></div>
</div>
{!compact && (
  <div class="weeks">
    {weeks.map((w) => (
      <div class="week done">
        <div class="w"><b>W{w.week}</b><span>done</span></div>
        <h4>{w.title}</h4>
        <p>{w.detail}</p>
      </div>
    ))}
  </div>
)}
