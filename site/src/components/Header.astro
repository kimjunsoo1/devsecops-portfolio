---
import { site, profile } from '../lib/data';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
---
<header class="site-header">
  <div class="wrap">
    <a href="/" class="brand" aria-label="홈으로">
      <span class="brand-mark">{site.initials}</span>
      <span>{site.name}</span>
    </a>
    <nav class="nav" aria-label="주 메뉴">
      {profile.nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
