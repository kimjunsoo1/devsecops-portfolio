---
import { site } from '../lib/data';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <span>© {year} {site.nameEn} · 이 사이트는 보안 게이트와 서명 검증을 통과한 빌드만 배포됩니다.</span>
    <span class="mono">
      <a href={site.repo} rel="noopener noreferrer">source ↗</a>
      &nbsp;·&nbsp;
      <a href={site.github} rel="noopener noreferrer">github ↗</a>
    </span>
  </div>
</footer>
