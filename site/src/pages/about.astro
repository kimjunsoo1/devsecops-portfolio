---
import Base from '../layouts/Base.astro';
import SkillCards from '../components/SkillCards.astro';
import { site, profile } from '../lib/data';
---
<Base title="About" description={`${site.name} — 경력, 역량, 자격, 강의`}>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow"><b>$</b> cat about.md</p>
      <h1>T자형 인재를 꿈꾸는<br />보안 전문가, 김준수입니다.</h1>
      <div class="intro">{profile.intro.map((p) => <p>{p}</p>)}</div>
      <p class="motto mono">motto: “{site.motto}” — 빠르게 해 보고, 하면서 배웁니다.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Experience</p><h2>SK쉴더스 EQST · 수석 · PM/수행원 <span class="muted">2016.10 —</span></h2></div></div>
      <div class="timeline">
        {profile.career.map((t) => (
          <div class="tl-item"><span class="period">{t.period}</span><div><h3>{t.title}</h3><p>{t.body}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Skills</p><h2>보유 역량</h2></div></div>
      <SkillCards />
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Teaching</p>
        <h2 class="h2">강의 경력</h2>
        <div class="timeline">
          {profile.teaching.map((t) => <div class="tl-item"><span class="period">{t.period}</span><div><h3>{t.org}</h3><p>{t.topic}</p></div></div>)}
        </div>
      </div>
      <div>
        <p class="eyebrow">Certifications</p>
        <h2 class="h2">자격</h2>
        <div class="timeline">
          {profile.certs.map((c) => <div class="tl-item"><span class="period">{c.date}</span><div><h3>{c.name}</h3><p>{c.issuer}</p></div></div>)}
        </div>
        <p class="eyebrow gap">Education</p>
        <div class="timeline">
          {profile.education.map((e) => <div class="tl-item"><span class="period">{e.period}</span><div><h3>{e.title}</h3><p>{e.body}</p></div></div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Writing</p><h2>외부 글 · 링크</h2></div></div>
      <div class="posts">
        {profile.writing.map((w) => (
          <a class="post-row" href={w.url} rel="noopener noreferrer"><time>link</time><div><h3>{w.title} ↗</h3></div><div></div></a>
        ))}
      </div>
    </div>
  </section>
</Base>
