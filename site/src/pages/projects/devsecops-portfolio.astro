---
import Base from '../../layouts/Base.astro';
import PipelineCard from '../../components/PipelineCard.astro';
import ArchFlow from '../../components/ArchFlow.astro';
import Roadmap from '../../components/Roadmap.astro';
import { site, devsecops as d } from '../../lib/data';
---
<Base title="DevSecOps Portfolio" description="이 사이트의 배포 파이프라인 — PR 게이트 10종, OIDC, 서명, 탐지 통제, 공격 검증">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow"><b>~/projects/</b>devsecops-portfolio</p>
      <h1>키 없는 배포,<br />게이트가 있는 파이프라인</h1>
      <p>{d.summary}</p>
      <div class="actions page-actions">
        <a class="btn btn-primary" href={site.repo} rel="noopener noreferrer">GitHub 리포지토리 ↗</a>
      </div>
    </div>
  </section>

  <section class="facts">
    <div class="wrap">
      {d.stats.map((s) => <div class="fact"><strong>{s.value}</strong><span>{s.label}</span></div>)}
    </div>
  </section>

  <section class="section">
    <div class="wrap feature">
      <div class="feature-body">
        <p class="eyebrow">Architecture</p>
        <h3>push부터 CloudFront까지</h3>
        <p>예방 통제(게이트 · 서명 · 권한 경계)와 탐지 통제(CloudTrail · GuardDuty · 알람)가 모두 있고, 둘 다 실제로 작동하는 것을 공격으로 확인했습니다.</p>
        <p class="eyebrow">Detection</p>
        <ul class="ticks">{d.detect.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="feature-art"><ArchFlow /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">PR gates</p>
        <h2 class="h2">하나라도 걸리면 머지 불가</h2>
        <p class="section-lead">게이트 수가 목적이 아닙니다. 도구마다 책임 영역을 하나씩 정해, 같은 판단을 두 곳에서 관리하지 않게 했습니다.</p>
        <div class="tbl">
          <table>
            <thead><tr><th>게이트</th><th>차단 기준</th><th>도입</th></tr></thead>
            <tbody>{d.gates.map((g) => <tr><td class="mono">{g.gate}</td><td>{g.block}</td><td class="nowrap">{g.week}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
      <div class="sticky"><PipelineCard /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Pipeline pentest</p><h2>방어를 공격으로 검증했습니다</h2><p class="section-lead">전부 본인 계정 · 본인 리포지토리 대상. 각 검증은 거부가 성공 결과입니다.</p></div></div>
      <div class="tbl">
        <table>
          <thead><tr><th>검증 대상</th><th>공격 가정</th><th>결과</th></tr></thead>
          <tbody>{d.pentest.map((p) => <tr><td><b>{p.check}</b></td><td>{p.attack}</td><td class="ok">{p.result}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="section-head sub"><div><p class="eyebrow">WAF</p><h2 class="h3">적용 후 직접 공격해 차단 확인</h2></div></div>
      <div class="tbl">
        <table>
          <thead><tr><th>룰</th><th>요청</th><th>결과</th></tr></thead>
          <tbody>{d.waf.map((w) => <tr><td class="mono">{w.rule}</td><td>{w.req}</td><td class={w.result === 'BLOCK' ? 'ok mono' : 'mono'}>{w.result}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Roadmap</p><h2>8주, 전부 완료</h2></div></div>
      <Roadmap />
      <p class="callout">{d.next}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Decisions</p><h2>설계 결정 — 비용이 제약이었고, 제약이 아키텍처를 정했습니다</h2></div></div>
      <div class="timeline">
        {d.decisions.map((x) => <div class="tl-item"><span class="period">{x.q}</span><p>{x.a}</p></div>)}
      </div>
    </div>
  </section>
</Base>
